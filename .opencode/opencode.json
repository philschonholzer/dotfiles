{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/local.md"],
  "plugin": [
    "opencode-models-discovery"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "nixos-rebuild *": "deny",
      "nixos-rebuild *--dry-*": "allow",
      "git push": "deny",
      "git push *": "deny",
      "git -c * push*": "deny",
      "git --git-dir* push*": "deny"
    }
  }
}
