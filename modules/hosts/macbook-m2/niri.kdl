// ARM/MacBook M2-specific configuration overrides
// This file contains only the differences from niri-base.kdl

spawn-at-startup "noctalia"

// ARM-specific environment variable for software GL rendering

input {
    mouse {
        natural-scroll
        left-handed
        scroll-factor 0.5
    }
    touchpad {
        accel-speed 0.5
        natural-scroll
    }
}

layout {
    default-column-width { fixed 1280; }
}

output "eDP-1" {
    mode "3024x1890@120.000"
    scale 2
    position x=600 y=1200
}
output "Philips Consumer Electronics Company PHL 346P1C UK02509040653" {
    mode "3440x1440@100"
    scale 1.2
    position x=0 y=0
}
