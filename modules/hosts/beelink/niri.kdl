// x86-specific configuration overrides
// This file contains only the differences from niri-base.kdl

input {
    mouse {
        left-handed
        natural-scroll
    }
}

layout {
    default-column-width { proportion 0.5; }
}

// LG Monitor configuration
output "DP-3" {
    mode "5120x2160"
    scale 1.6
    position x=0 y=0
}

// DELL of Maria
output "Dell Inc. DELL U3818DW 5KC0398F0RYL" {
    mode "3840x1600"
    scale 1.25
    position x=0 y=0
}
